{
  "name": "@factorypeer/catalog-admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:catalog-models": "node ./node_modules/typescript/lib/tsc.js -p ../catalog-models/tsconfig.build.json",
    "predev": "npm run build:catalog-models",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build:catalog-models",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build:catalog-models",
    "typecheck": "tsc --noEmit",
    "preseed:content": "npm run build:catalog-models",
    "seed:content": "tsx src/scripts/seed-merchandising-content.ts",
    "migrate:media": "tsx src/scripts/migrate-legacy-media-to-cloudinary.ts",
    "reset:electrical-showcase": "tsx src/scripts/reset-catalog-and-rebuild-electrical.ts",
    "repair:spec-linkage": "tsx src/scripts/repair-spec-linkage.ts"
  },
  "dependencies": {
    "@factorypeer/catalog-models": "file:../catalog-models",
    "@fastify/multipart": "^10.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "form-data": "^4.0.5",
    "mongoose": "^8.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
