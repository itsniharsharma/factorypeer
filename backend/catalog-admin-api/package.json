{
  "name": "@factorypeer/catalog-admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "predev": "npm run build --prefix ../catalog-models",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --prefix ../catalog-models",
    "build": "tsc",
    "prestart": "npm run build --prefix ../catalog-models",
    "start": "node dist/server.js",
    "pretypecheck": "npm run build --prefix ../catalog-models",
    "typecheck": "tsc --noEmit",
    "preseed:content": "npm run build --prefix ../catalog-models",
    "seed:content": "tsx src/scripts/seed-merchandising-content.ts"
  },
  "dependencies": {
    "@factorypeer/catalog-models": "file:../catalog-models",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "mongoose": "^8.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
