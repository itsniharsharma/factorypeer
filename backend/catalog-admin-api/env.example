# Prefer the monorepo root `.env.example` — variables are loaded from
# `../../.env` and `../../.env.local` via `src/bootstrap-env.ts` when the API starts.
# You can still use a local `.env` in this folder for overrides if needed.
# 
# This file is primarily for documentation. For development, use:
#   • Repo root `.env.local` for shared dev overrides
#   • `backend/catalog-admin-api/.env.local` for API-only overrides
#
# =============================================================================
# Required for catalog-admin-api (Render deployment)
# =============================================================================

# MongoDB Atlas connection URI (required for all environments)
# Format: mongodb+srv://user:pass@cluster.mongodb.net/database_name?retryWrites=true&w=majority
# MONGODB_URI=

# Fastify server port (Render usually auto-assigns via PORT env)
# PORT=4040

# Bind to all network interfaces (required for containerized deployments)
# HOST=0.0.0.0

# =============================================================================
# Optional: Authentication & Configuration
# =============================================================================

# [SHARED] Bearer token for /admin/catalog routes (must match Vercel CATALOG_ADMIN_API_KEY)
# Min 16 characters. Generate: openssl rand -hex 24
# CATALOG_ADMIN_API_KEY=

# Optional: Single-tenant ObjectId filter for multi-tenant catalogs
# CATALOG_TENANT_ID=

# Optional: Log level (fatal, error, warn, info, debug, trace, silent)
# Default: info (production) or debug (development)
# LOG_LEVEL=info

# =============================================================================
# Required: Cloudinary (for media uploads in /admin/catalog/media)
# =============================================================================

# Option A: Single URL (preferred for security)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option B: Split credentials (alternative, all three required if using this option)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# Required: Upstash Redis (shared cache backend)
# =============================================================================

# Upstash REST API base URL
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io

# Upstash REST API bearer token
# UPSTASH_REDIS_REST_TOKEN=your-token

# =============================================================================
# Optional: Media Defaults (Cloudinary delivery URLs for seeds/fallbacks)
# =============================================================================

# Default image for seeds and storefront fallbacks (HTTPS Cloudinary URL)
# Format: https://res.cloudinary.com/<cloud>/image/upload/<folder>/<asset>.jpg
# CATALOG_SEED_DEFAULT_IMAGE_URL=

# =============================================================================
# Optional: DNS Configuration (for Atlas + Windows + Node 18+ TLS issues)
# =============================================================================

# IPv4/IPv6 family selection (default: 4 for Windows+Atlas compatibility)
# Values: 4 (IPv4), 6 (IPv6), auto (auto-select), 0 (disable)
# MONGODB_DNS_FAMILY=4

# =============================================================================
# Environment (set by Render automatically)
# =============================================================================

# NODE_ENV=production

