# Copy to .env (gitignored). Atlas: append DB name and query params.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/factorypeer_catalog?retryWrites=true&w=majority
PORT=4040
HOST=0.0.0.0

# Optional. Default forces IPv4 + autoSelectFamily=false (fixes Atlas TLS on Windows/Node 18+).
# Use "auto" or "0" to use driver defaults; "6" for IPv6-only networks.
# MONGODB_DNS_FAMILY=
